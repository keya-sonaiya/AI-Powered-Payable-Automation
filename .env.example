# ── Database ──────────────────────────────────────────────────────────────
# Full connection string FastAPI/SQLAlchemy uses. Inside docker-compose the
# host is the service name "postgres"; override for local (non-docker) runs.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Ollama Cloud (Phase 2) ───────────────────────────────────────────────
# Corrected API: POST {OLLAMA_HOST}/api/chat with a "messages" array.
# Model name for the hosted API is "gpt-oss:120b" (no "-cloud" suffix — that
# suffix is only used for local `ollama run` invocations).
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
# Ollama Cloud rejects a burst of parallel chat requests. Keep the default of
# one; increase only after confirming the account's concurrency allowance.
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY_SECONDS=2
# Serialize complete ingests as well: a SQLAlchemy session holds its database
# connection while the audit explanation is generated.
INGEST_MAX_CONCURRENCY=1

# ── Frontend (Phase 3) ───────────────────────────────────────────────────
# Two different base URLs, because the frontend code runs in two places:
# NEXT_PUBLIC_API_URL — used by the BROWSER (the "replay a sample invoice"
#   button). Must be reachable from your machine, so it's the host-mapped
#   port. This is baked into the frontend image at BUILD time (Next.js
#   inlines NEXT_PUBLIC_* vars into the browser bundle) — changing it after
#   `docker compose build` requires a rebuild, not just a restart.
# API_INTERNAL_URL — used by the frontend CONTAINER's own server-side
#   rendering (the dashboard and audit pages fetch on the server before
#   sending HTML to the browser). Set to the backend's service name on the
#   docker-compose network; "localhost" here would mean the frontend
#   container itself, not the backend. Not read at build time, so a plain
#   restart picks up changes.
# Never call n8n or Ollama directly from the frontend either way.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://backend:8000

# ── CORS ──────────────────────────────────────────────────────────────────
# Origin FastAPI's CORSMiddleware allows (Phase 2 wires this into main.py).
FRONTEND_ORIGIN=http://localhost:3000

# ── n8n (containerized in docker-compose) ───────────────────────────────
N8N_BASIC_AUTH_ACTIVE=false
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
# IANA timezone used by n8n's Schedule Trigger (UTC+05:30).
GENERIC_TIMEZONE=Asia/Kolkata

# ── Chroma / policy retrieval (Phase 2) ─────────────────────────────────
# Embedded/local Chroma persistence path INSIDE the backend container.
# Deliberately no volume mounted for this (see PROGRESS.md "known gaps") —
# ap_policy.md is small, static, and re-embedded on every container start.
CHROMA_PERSIST_DIR=/app/chroma_data

# ── Mock data seed (Phase 2) ─────────────────────────────────────────────
# Path INSIDE the backend container (docker-compose mounts ./mock_data
# there) that main.py's startup hook reads to seed vendors/POs/receipts if
# the vendors table is empty. Invoices are NOT seeded this way — they flow
# through POST /ingest via the n8n workflow.
MOCK_DATA_PATH=/mock_data/output/mock_dataset.json
